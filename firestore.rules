rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'email', 'createdAt'])
        && request.resource.data.uid == userId;
    }

    // Agent Quiz Results
    match /users/{userId}/quizResults/{resultId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.score is number
        && request.resource.data.totalQuestions is number;
      allow update, delete: if isOwner(userId);
    }

    // Trainer Questions
    match /trainerQuestions/{questionId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 1000;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
