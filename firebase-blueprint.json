{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and assigned LOB preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "Agent email address" },
        "displayName": { "type": "string", "maxLength": 100 },
        "lobId": { "type": "string", "enum": ["csr", "tsr", "sales", "activation", "canquest"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "Agent quiz completion and score record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "topicId": { "type": "string" },
        "topicTitle": { "type": "string" },
        "lobId": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "passed": { "type": "boolean" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "topicId", "score", "totalQuestions", "passed"]
    },
    "TrainerQuestion": {
      "title": "TrainerQuestion",
      "description": "Agent questions submitted to trainers via Ask Trainer module.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "lobId": { "type": "string" },
        "question": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "answered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userEmail", "question", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Agent profile documents"
    },
    "/users/{userId}/quizResults/{resultId}": {
      "schema": "QuizResult",
      "description": "Historical quiz scores for an agent"
    },
    "/trainerQuestions/{questionId}": {
      "schema": "TrainerQuestion",
      "description": "Questions submitted by agents to trainers"
    }
  }
}
